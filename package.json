{
  "name": "exp1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 1420",
    "dev:android": "tauri android dev --no-dev-server",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "build:android:all": "tauri android build --apk",
    "build:android": "tauri android build --target aarch64 --apk",
    "build:android:debug": "tauri android build --target aarch64 --debug --apk",
    "launch:android:debug": "adb shell monkey -p com.ruinb0w.exp1.debug -c android.intent.category.LAUNCHER 1",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "dexie": "^4.3.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.2.1",
    "tauri-plugin-background-service": "^0.7.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "pnpm@10.32.1"
}
